# Environment Variables - Development Setup

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# MongoDB (usando versione locale o mock)
MONGODB_URI=mongodb://localhost:27017/otakuverse
DB_NAME=otakuverse

# JWT
JWT_SECRET=test-secret-key-change-in-production
JWT_EXPIRE=7d

# Firebase
FIREBASE_PROJECT_ID=otakuverse-test
FIREBASE_PRIVATE_KEY=test-private-key
FIREBASE_CLIENT_EMAIL=test@otakuverse.iam.gserviceaccount.com

# Redis
REDIS_URL=redis://localhost:6379

# Stripe
STRIPE_SECRET_KEY=sk_test_test123456789
STRIPE_PUBLISHABLE_KEY=pk_test_test123456789
STRIPE_WEBHOOK_SECRET=whsec_test123456789

# External APIs
JIKAN_API_URL=https://api.jikan.moe/v4
ANILIST_API_URL=https://graphql.anilist.co
YOUTUBE_API_KEY=test-youtube-key

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=test@gmail.com
EMAIL_PASSWORD=test-password

# AWS
AWS_ACCESS_KEY_ID=test-aws-key
AWS_SECRET_ACCESS_KEY=test-aws-secret
AWS_S3_BUCKET=otakuverse-media

# Logging
LOG_LEVEL=debug
